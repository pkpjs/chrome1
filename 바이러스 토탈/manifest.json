{
  "manifest_version": 3,
  "name": "VirusTotal 검사기",
  "version": "1.0.0",
  "description": "URL, 현재 탭, IP 주소를 VirusTotal로 검사합니다. 위험할 경우 빨간색으로 표시됩니다.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://www.virustotal.com/*"
  ]
}
